{
	"name": "pihole-in-one",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"intl:generate": "node scripts/generate-locales.ts",
		"intl:prune": "node scripts/prune-locales.js",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"typecheck": "vue-tsc --noEmit",
		"release:patch": "pnpm version patch && git push && git push --tags",
		"release:minor": "pnpm version minor && git push && git push --tags",
		"release:major": "pnpm version major && git push && git push --tags"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/vue": "^1.63.0",
		"@wxt-dev/storage": "^1.3.0",
		"intl-messageformat": "^12.1.4",
		"pihole-js": "^1.6.1",
		"vue": "^3.5.44",
		"vue-i18n": "^11.4.16",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@wxt-dev/module-vue": "^1.0.3",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite-svg-loader": "^5.1.3",
		"vue-tsc": "3.3.13",
		"wxt": "^0.21.4"
	},
	"packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
